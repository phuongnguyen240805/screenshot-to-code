# screenshot-to-code backend — copy to .env and fill keys
# Used by docker-compose (liora-monorepo/docker) profile s2c

BACKEND_PORT=7010

# At least one LLM key required for real generation
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
REPLICATE_API_KEY=
OPENAI_BASE_URL=
SCREENSHOTONE_API_KEY=

# Debug
# IS_DEBUG_ENABLED=false
# PROMPT_REPORTS_ENABLED=false